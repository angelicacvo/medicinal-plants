# Configuración de Variables de Entorno

# Database - Local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=task_management

# Database - Cloud (ejemplo con Railway/Render/Supabase)
# Descomentar y configurar cuando uses base de datos en la nube
# DB_HOST=your-cloud-host.railway.app
# DB_PORT=5432
# DB_USERNAME=your-cloud-user
# DB_PASSWORD=your-cloud-password
# DB_DATABASE=railway
# DB_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Application
PORT=3000
NODE_ENV=development

# Para testing
# NODE_ENV=test
# DB_DATABASE=task_management_test
